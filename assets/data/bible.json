[
  {
    "book_id": 1,
    "book_name": "ዘፍጥረት",
    "chapters": [
      {
        "chapter": 1,
        "verses": [
          {
            "verse": 1,
            "text": "በመጀመሪያ እግዚአብሔር ሰማይንና ምድርን ፈጠረ።"
          },
          {
            "verse": 2,
            "text": "ምድርም ባዶ ነበረች፤ አንዳችም አልነበረባትም፤ ጨለማም በጥልቁ ላይ ነበረ፤ የእግዚአብሔርም መንፈስ በውኃ ላይ ይሰፍር ነበር።"
          },
          {
            "verse": 3,
            "text": "እግዚአብሔርም፦ ብርሃን ይሁን አለ፤ ብርሃንም ሆነ።"
          }
        ]
      },
      {
        "chapter": 2,
        "verses": [
          {
            "verse": 1,
            "text": "ሰማይና ምድር ሠራቸውም ሁሉ ተፈጸሙ።"
          },
          {
            "verse": 2,
            "text": "እግዚአብሔርም የሠራውን ሥራ በሰባተኛው ቀን ፈጸመ፤ ከሠራውም ሥራ ሁሉ በሰባተኛው ቀን ዐረፈ።"
          }
        ]
      }
    ]
  },
  {
    "book_id": 2,
    "book_name": "ዘጸአት",
    "chapters": [
      {
        "chapter": 1,
        "verses": [
          {
            "verse": 1,
            "text": "ከያዕቆብ ጋር ወደ ግብፅ የገቡት የእስራኤል ልጆች ስም ይህ ነው፤ እያንዳንዱ ከቤተ ሰቡ ጋር ገባ፤"
          }
        ]
      }
    ]
  }
]